# Скопируйте в .env и поменяйте пароль/имя пользователя
POSTGRES_USER=gameshelf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gameshelf

# Для локального запуска через `uv run uvicorn` (база проброшена на localhost)
DATABASE_URL=postgresql://gameshelf:change-me@localhost:5432/gameshelf

# Версия образа и имя образа в ghcr.io — подставьте свой логин GitHub
APP_VERSION=dev
IMAGE_NAME=ghcr.io/eoka-rust/game-shelf
